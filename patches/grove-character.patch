@@ -0,0 +1,163 @@
+"""Shared leaf retrieval: facts and visual clips retain their type and provenance."""
+from __future__ import annotations
+
+import asyncio
+import math
+from ..visual_retriever import clip_id
+from ..score_propagation import normalize_scores, propagate_mult, propagate_additive, propagate_rrf
+
+
+def clip_record(node, episode):
+    start, end = node.start_seconds, node.end_seconds
+    # Older visual_indexing versions wrote seconds-in-day despite the schema.
+    if 0 <= start < 86400 and 0 < end <= 86400 and episode.start_seconds >= node.day*86400:
+        start, end = start+node.day*86400, end+node.day*86400
+    if (node.day != episode.day or not math.isfinite(start) or not math.isfinite(end)
+            or not start < end or end <= episode.start_seconds or start >= episode.end_seconds):
+        raise ValueError('visual clip time/day does not overlap its parent episode')
+    return dict(id=node.id, node_type='visual_clip', clip_id=node.id,
+                episode_ids=[node.parent_episode_id], parent_episode_id=node.parent_episode_id,
+                day=node.day, start_seconds=start, end_seconds=end,
+                temporal=node.frame_time_span, frame_time_span=node.frame_time_span,
+                caption_text=node.caption_text, content=node.caption_text)
+
+
+def episode_clip_records(hg, episode_ids):
+    records = {}
+    for eid in sorted(episode_ids):
+        ep = hg.episodes[eid]
+        if ep.window_hyperedge_id:
+            edge = hg.episode_window_hyperedges.get(ep.window_hyperedge_id)
+            if edge is None or edge.episode_id != eid:
+                raise ValueError('invalid episode-to-window hyperedge')
+            ids = edge.relation.keys()
+        else:
+            # Imported graphs may carry only the reverse parent link.
+            ids = [cid for cid, node in hg.visual_clips.items() if node.parent_episode_id == eid]
+        for cid in ids:
+            node = hg.visual_clips.get(cid)
+            if node is None or node.parent_episode_id != eid:
+                raise ValueError('window hyperedge references a missing clip or a different parent')
+            records[cid] = clip_record(node, ep)
+    return records
+
+
+def rank_evidence(records, episode_hits, topic_hits, episode_to_topic, top_k, score_prop='none'):
+    """Merge channel ranks; cosine and text RRF scores are not directly comparable.
+
+    Equal channel weights, shared top-k budget, deterministic ties. This is rank
+    calibration of disjoint node types, not corroboration by two independent ranks.
+    """
+    if score_prop not in ('none', 'mult', 'additive', 'rrf'):
+        raise ValueError('invalid score propagation mode')
+    scores = {(r['node_type'], r['id']): 1/(60+r['channel_rank']) for r in records}
+    ep_scores, topic_scores = dict(episode_hits), dict(topic_hits)
+    parents = {(r['node_type'], r['id']): max(r['episode_ids'],
+               key=lambda eid: (ep_scores.get(eid, 0), eid), default='') for r in records}
+    if score_prop in ('mult', 'additive'):
+        func = propagate_mult if score_prop == 'mult' else propagate_additive
+        # Rank scores on a common scale; per-channel raw magnitudes never mix.
+        scores = func({key: value*60 for key, value in scores.items()}, parents,
+                      normalize_scores(ep_scores), episode_to_topic, normalize_scores(topic_scores))
+    elif score_prop == 'rrf':
+        scores = propagate_rrf({(r['node_type'], r['id']): r['channel_rank'] for r in records},
+                    parents, {key: i for i, (key, _) in enumerate(episode_hits)}, episode_to_topic,
+                    {key: i for i, (key, _) in enumerate(topic_hits)})
+    for row in records:
+        row['score'] = scores[(row['node_type'], row['id'])]
+    return sorted(records, key=lambda r: (-r['score'], r['channel_rank'], r['node_type'], r['id']))[:top_k]
+
+
+async def retrieve_leaves(hg, dual, query, episode_hits, topic_hits, *, top_k,
+                          allowed_episode_ids, allowed_fact_ids=None, visual_retriever=None,
+                          use_visual_channel=True, score_prop='none', min_visual_score=None,
+                          bm25_query=None, cutoff_seconds=None):
+    """Filter graph scope before scoring. A visual hit never requires a fact hit."""
+    if top_k < 1:
+        raise ValueError('top_k must be positive')
+    allowed_episode_ids = set(allowed_episode_ids) & hg.episodes.keys()
+    episode_hits = [(eid, score) for eid, score in episode_hits if eid in allowed_episode_ids]
+    selected = {eid for eid, _ in episode_hits} or allowed_episode_ids
+    episode_to_topic = {}
+    for tid, _ in sorted(topic_hits, key=lambda pair: (-pair[1], pair[0])):
+        topic = hg.topics.get(tid)
+        if topic:
+            for eid in topic.episode_ids:
+                episode_to_topic.setdefault(eid, tid)
+    fact_parents = {}
+    for fid, node in hg.facts.items():
+        if allowed_fact_ids is not None and fid not in allowed_fact_ids:
+            continue
+        parents = set(node.episode_ids) & selected
+        if parents:
+            fact_parents[fid] = sorted(parents)
+    for eid in selected:
+        edge = hg.get_fact_hyperedge_for_episode(eid)
+        if edge:
+            for fid in edge.relation:
+                if fid in hg.facts and (allowed_fact_ids is None or fid in allowed_fact_ids):
+                    fact_parents.setdefault(fid, [])
+                    if eid not in fact_parents[fid]:
+                        fact_parents[fid].append(eid)
+    records, debug = [], [f'leaf_episodes={len(selected)} fact_candidates={len(fact_parents)}']
+    if fact_parents:
+        kwargs = {'bm25_query': bm25_query} if bm25_query is not None else {}
+        hits = await dual.search_within(query, set(fact_parents), 'fact', top_n=top_k*2, **kwargs)
+        seen = set()
+        for rank, (fid, score) in enumerate(hits):
+            if fid not in fact_parents or fid in seen or not math.isfinite(score):
+                raise ValueError('invalid fact index hit')
+            seen.add(fid)
+            row = hg.facts[fid].model_dump(mode='json')
+            row.update(id=fid, node_type='fact', fact_id=fid, episode_ids=sorted(fact_parents[fid]),
+                       source_episode_ids=list(hg.facts[fid].episode_ids),
+                       raw_score=float(score), channel_rank=rank)
+            records.append(row)
+    if use_visual_channel:
+        candidates = episode_clip_records(hg, selected)
+        if cutoff_seconds is not None:
+            candidates = {cid: row for cid, row in candidates.items() if row['end_seconds'] <= cutoff_seconds}
+        debug.append(f'visual_candidates={len(candidates)}')
+        if candidates:
+            if visual_retriever is None:
+                raise ValueError('visual channel enabled but no visual index/retriever configured')
+            days = sorted({row['day'] for row in candidates.values()})
+            hits = await asyncio.to_thread(visual_retriever.search_within, query, set(candidates),
+                                           top_k=top_k*2, days=days, min_score=min_visual_score)
+            seen = set()
+            for rank, (_, score, meta) in enumerate(hits):
+                cid = clip_id(meta)
+                if cid not in candidates or cid in seen or not math.isfinite(score):
+                    raise ValueError('invalid visual index hit')
+                seen.add(cid)
+                row = candidates[cid]
+                parent = meta.get('episode_id') or meta.get('parent_episode_id')
+                if parent != row['parent_episode_id'] or int(meta['day']) != row['day']:
+                    raise ValueError('visual index metadata does not match graph clip/parent')
+                dim = hg.visual_clips[cid].visual_embedding_dim
+                if dim and dim != visual_retriever.dim:
+                    raise ValueError('graph clip embedding dimension does not match index')
+                for key, absolute in [('start_sec_in_day', 'start_seconds'), ('end_sec_in_day', 'end_seconds')]:
+                    if key in meta and abs(meta[key]+row['day']*86400-row[absolute]) > 1e-4:
+                        raise ValueError('visual index time range does not match graph clip')
+                row.update(raw_score=float(score), channel_rank=rank)
+                records.append(row)
+        else:
+            debug.append('visual channel has no clips in selected episodes')
+    evidence = rank_evidence(records, episode_hits, topic_hits, episode_to_topic, top_k, score_prop)
+    parent_ids = list(dict.fromkeys(eid for row in evidence for eid in row['episode_ids']))
+    parents = [hg.episodes[eid].model_dump(mode='json') for eid in parent_ids]
+    debug.append(f"returned_facts={sum(r['node_type']=='fact' for r in evidence)} "
+                 f"returned_visual_clips={sum(r['node_type']=='visual_clip' for r in evidence)}")
+    return evidence, parents, debug
+
+
+def format_evidence(records, max_chars=400):
+    lines = []
+    for row in records:
+        kind = row.get('node_type', 'fact')
+        content = row.get('content') or row.get('caption_text') or '(no stored caption; inspect the clip)'
+        location = row.get('frame_time_span') or row.get('temporal') or ''
+        parents = ','.join(row.get('episode_ids', []))
+        lines.append(f"[{kind}:{row.get('id', '')}] [{location}] [episodes={parents}] {content[:max_chars]}")
+    return '\n'.join(lines) if lines else '(no evidence retrieved)'
