+++ b/hypervideo/modules/character_projection.py
@@ -0,0 +1,162 @@
+"""Transactional, replayable character materialization over the real Grove graph."""
+import copy
+from .character_links import (bind, rebind_ref, project_clip, covered, build_index,
+                              fingerprint, lookup, validate_state, validate_event)
+from .character_identity import CHARACTER, rewrite_text, validate_evidence
+
+
+def evidence_records(hg):
+    """The index fingerprint includes scope and rendered text, not just node counts."""
+    records = []
+    for kind, nodes in [('fact', hg.facts), ('visual_clip', hg.visual_clips)]:
+        for _, node in sorted(nodes.items()):
+            parents = node.episode_ids or ([node.parent_episode_id] if kind=='visual_clip' else [])
+            scope = [dict(id=eid, source_id=hg.episodes[eid].source_id, day=hg.episodes[eid].day,
+                start=hg.episodes[eid].start_seconds, end=hg.episodes[eid].end_seconds) for eid in sorted(parents)]
+            records.append(dict(node_type=kind, parent_scope=scope, **node.model_dump(mode='json')))
+    return records
+
+
+def text_fingerprint(hg):
+    return fingerprint(dict(state=hg.character_catalog.get('state', {}).get('state_id'),
+        facts={k: n.model_dump(mode='json') for k,n in sorted(hg.facts.items())},
+        episodes={k: n.model_dump(mode='json') for k,n in sorted(hg.episodes.items())},
+        topics={k: n.model_dump(mode='json') for k,n in sorted(hg.topics.items())}))
+
+
+def _evidence(evidence, state):
+    result = copy.deepcopy(evidence)
+    if not result: return result
+    result.update(graph_revision=state['revision'], identity_state_id=state['state_id'])
+    for row in result['feature_mapping'].values():
+        row.update(rebind_ref(row, state))
+    result['direct_renderings'] = {}
+    for token, ids in result.get('direct_bindings', {}).items():
+        person = bind(ids, state)['character_id']
+        result['direct_renderings'][token] = f'<{person}>' if person else '<unknown>'
+    return result
+
+
+def rebuild_characters(hg, state, snapshots=()):
+    """Return a new graph only after every projection succeeds; caller swaps/saves it.
+
+    No inference is repeated. Old snapshots supply immutable observations, never old
+    character assignments. Incomplete legacy timelines remain explicitly incomplete.
+    """
+    validate_state(state)
+    result = type(hg).from_dict(hg.to_dict())
+    events = {e['id']: copy.deepcopy(e) for e in hg.character_catalog.get('events', [])}
+    spans = {s['episode_id']: copy.deepcopy(s) for s in hg.character_catalog.get('source_spans', [])}
+    inputs = list(snapshots)
+    inputs += [ep.identity_evidence['projection_input'] for ep in result.episodes.values()
+               if 'projection_input' in ep.identity_evidence]
+    for item in inputs:
+        matches = [ep for ep in result.episodes.values()
+                   if (not ep.source_id or ep.source_id == item['source']) and
+                   abs(ep.start_seconds-item['start'])<1e-6 and abs(ep.end_seconds-item['end'])<1e-6]
+        if len(matches) != 1: raise ValueError('projection requires one source-qualified episode')
+        ep = matches[0]
+        ep.source_id = item['source']
+        spans[ep.id] = dict(episode_id=ep.id, source=item['source'], start=item['start'],
+                           end=item['end'], complete=item['face_timeline_complete'])
+        for event in item['temporal_evidence']:
+            if event['source'] != item['source'] or not item['start'] <= event['start'] <= event['end'] <= item['end']:
+                raise ValueError('temporal evidence outside its source episode')
+            if event['id'] in events and events[event['id']] != event:
+                raise ValueError('immutable temporal evidence changed')
+            events[event['id']] = copy.deepcopy(event)
+    # Validate the timeline even before any visual windows have been built.
+    for event in events.values(): validate_event(event, state)
+    for ep in result.episodes.values():
+        ep.character_refs = [rebind_ref(ref, state) for ref in ep.character_refs]
+        ep.identity_evidence = _evidence(ep.identity_evidence, state)
+        if ep.identity_evidence:
+            ep.identity_evidence = validate_evidence(ep.identity_evidence, ep.character_refs, state['revision'])
+            if 'projection_input' in ep.identity_evidence:
+                ep.identity_evidence['projection_input']['identity_state'] = copy.deepcopy(state)
+            raw = ep.identity_evidence.get('writer_summary_raw', {})
+            for key, field in [('summary','summary'), ('subject','subject'), ('description','episode_description'),
+                               ('keywords','keywords')]:
+                if key in raw:
+                    value = raw[key]
+                    setattr(ep, field, [rewrite_text(t, ep.identity_evidence) for t in value]
+                            if isinstance(value, list) else rewrite_text(value, ep.identity_evidence))
+                elif CHARACTER.search(str(getattr(ep, field))):
+                    raise ValueError('legacy summary lacks raw identity evidence; rerun writer')
+    for fact in result.facts.values():
+        fact.character_refs = [rebind_ref(ref, state) for ref in fact.character_refs]
+        fact.identity_evidence = _evidence(fact.identity_evidence, state)
+        if fact.identity_evidence:
+            fact.identity_evidence = validate_evidence(fact.identity_evidence,
+                [r for r in fact.character_refs if r['role']=='speaker'], state['revision'])
+            fact.content = rewrite_text(fact.identity_evidence['raw_content'], fact.identity_evidence)
+        elif CHARACTER.search(fact.content):
+            raise ValueError('legacy fact lacks raw identity evidence; rerun writer')
+    from ..retrieval.multimodal import clip_record
+    for clip in result.visual_clips.values():
+        parent = result.episodes.get(clip.parent_episode_id)
+        if parent is None: raise ValueError('clip parent missing')
+        source = clip.source_id or parent.source_id
+        if not source: raise ValueError('clip source unknown; assign episode.source_id before projection')
+        if parent.source_id != source: raise ValueError('clip/episode source mismatch')
+        record = clip_record(clip, parent)
+        clip.source_id = source
+        clip.start_seconds, clip.end_seconds = record['start_seconds'], record['end_seconds']
+        window = dict(source=source, start=clip.start_seconds, end=clip.end_seconds)
+        clip.episode_ids = sorted(ep.id for ep in result.episodes.values() if ep.source_id==source and
+            ep.start_seconds < clip.end_seconds and ep.end_seconds > clip.start_seconds)
+        clip.character_refs = project_clip(window, list(events.values()), state)
+        caption_raw = clip.identity_evidence.get('caption_raw', clip.caption_text)
+        caption_bindings = copy.deepcopy(clip.identity_evidence.get('caption_bindings', {}))
+        if CHARACTER.search(caption_raw) and not caption_bindings:
+            old_state = hg.character_catalog.get('state', state)
+            old_refs = project_clip(window, list(events.values()), old_state)
+            for token in CHARACTER.findall(caption_raw):
+                ids = list(dict.fromkeys(oid for ref in old_refs if f"<{ref['character_id']}>"==token
+                                         for oid in ref['identity_observation_ids']))
+                if not ids: raise ValueError('clip caption character has no temporal identity evidence')
+                caption_bindings[token] = ids
+        clip.caption_text = CHARACTER.sub(lambda m: '<'+(bind(caption_bindings[m.group()], state)['character_id'] or 'unknown')+'>', caption_raw)
+        clip.identity_evidence = dict(identity_state_id=state['state_id'], graph_revision=state['revision'],
+            face_timeline_complete=covered(window, [s for s in spans.values() if s['complete']]),
+            caption_raw=caption_raw, caption_bindings=caption_bindings)
+    # Rebuild window edges to include every overlapping episode; retain canonical NPZ parent.
+    for ep in result.episodes.values():
+        ids = sorted(c.id for c in result.visual_clips.values() if ep.id in c.episode_ids)
+        if ids or ep.window_hyperedge_id:
+            result.add_episode_window_hyperedge(ep.window_hyperedge_id or 'character_windows:'+ep.id, ep.id, ids)
+    # Topic summaries are generated outside the evidence-aware writer. If they contain
+    # identity tokens, invalidate them instead of leaving incorrect IDs in text search.
+    changed = hg.character_catalog.get('state', {}).get('state_id') != state['state_id']
+    invalidated = list(hg.character_catalog.get('invalidated_topics', []))
+    if changed:
+        for topic in result.topics.values():
+            for field in ('title', 'summary', 'keywords'):
+                value = getattr(topic, field)
+                if CHARACTER.search(str(value)):
+                    if topic.id not in invalidated: invalidated.append(topic.id)
+                    setattr(topic, field, [CHARACTER.sub('<unknown>', t) for t in value]
+                        if isinstance(value, list) else CHARACTER.sub('<unknown>', value))
+    result.character_catalog = dict(state=copy.deepcopy(state), events=list(events.values()),
+        source_spans=list(spans.values()), invalidated_topics=invalidated)
+    result.character_index = build_index(evidence_records(result), state)
+    from .fact_clips import rebuild_fact_clips
+    return rebuild_fact_clips(result)
+
+
+def refresh_characters(hg):
+    states = [ep.identity_evidence['projection_input']['identity_state'] for ep in hg.episodes.values()
+              if 'projection_input' in ep.identity_evidence]
+    if hg.character_catalog: states.append(hg.character_catalog['state'])
+    if not states: return hg
+    latest = max(states, key=lambda s: s['revision'])
+    if any(s['revision']==latest['revision'] and s['state_id']!=latest['state_id'] for s in states):
+        raise ValueError('conflicting identity branches; supply an explicit state to rebuild_characters')
+    return rebuild_characters(hg, latest)
+
+
+def character_hits(hg, selectors, roles=None):
+    if not hg.character_catalog: raise ValueError('character projections missing; rebuild first')
+    if hg.character_index.get('records_fingerprint') != fingerprint(evidence_records(hg)):
+        raise ValueError('stale character index; rebuild before retrieval')
+    return lookup(hg.character_index, hg.character_catalog['state'], selectors, roles)
