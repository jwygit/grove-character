@@ -0,0 +1,31 @@
+"""Content-addressed text cache guard for graphs with character projections."""
+import json
+import os
+from pathlib import Path
+from .character_projection import text_fingerprint
+
+
+async def ensure_character_text_index(owner):
+    """False preserves ordinary Grove's cache path; character graphs require exact content."""
+    hg = owner.hypergraph_builder.hypergraph
+    if not hg.character_catalog: return False
+    version = text_fingerprint(hg)
+    if getattr(owner, '_character_text_version', None) == version:
+        owner.hypergraph_builder.mark_index_clean()
+        return True
+    marker = Path(owner.working_dir)/'character_text_index.json'
+    try:
+        metadata = json.loads(marker.read_text())
+        if metadata['fingerprint'] != version: raise ValueError('text content changed')
+        owner.dual_index.load(owner.working_dir, owner.hyper_config)
+    except (OSError, ValueError, KeyError, TypeError):
+        # Remove marker first: failed saves must never bless partial cache files.
+        marker.unlink(missing_ok=True)
+        await owner.dual_index.rebuild(hg)
+        owner.dual_index.save(owner.working_dir, owner.hyper_config)
+        temp = marker.with_suffix('.tmp')
+        temp.write_text(json.dumps({'fingerprint': version}))
+        os.replace(temp, marker)
+    owner._character_text_version = version
+    owner.hypergraph_builder.mark_index_clean()
+    return True
